# Copy to .env. Never send your key in chat or commit .env.
# openai: your question, conversation and selected graph facts are sent to OpenAI.
# ollama: inference runs on your computer; install a model supporting tools.
MONEYGRAPH_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
